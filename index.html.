<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title>Безопасная школа</title>
  <style>
    body { font-family: Arial, sans-serif; background:#f0f2f5; margin:0; }
    .container { width:80%; margin:20px auto; }
    .card { background:#fff; padding:20px; margin:10px 0; border-radius:10px; box-shadow:0 2px 5px rgba(0,0,0,0.1); }
    .card h3 { margin-top:0; }
    .btn { display:inline-block; padding:10px; background:#4a90e2; color:#fff; border:none; border-radius:5px; cursor:pointer; margin-top:10px; }
    .btn:hover { background:#357ab8; }
    #chatWindow { height:300px; overflow-y:auto; border:1px solid #ccc; padding:10px; margin-bottom:10px; }
    #chatBot { margin-top:30px; }
    input, textarea { width:80%; padding:10px; margin:5px 0; }
    table { width:100%; border-collapse:collapse; margin-top:10px; }
    th, td { border:1px solid #ccc; padding:8px; text-align:center; }
  </style>
</head>
<body>
  <div class="container">
    <h1>Цифровые инструменты для безопасной школы</h1>

    <!-- Анонимная помощь -->
    <div class="card">
      <h3>Платформа анонимной помощи</h3>
      <p>Ученик может анонимно сообщить о буллинге.</p>
      <textarea id="anonMessage" placeholder="Опишите проблему..."></textarea>
      <button class="btn" onclick="sendAnon()">Отправить анонимно</button>
    </div>

    <!-- Чат-бот -->
    <div class="card" id="chatBot">
      <h3>Многоязычный чат-бот против буллинга</h3>
      <div id="chatWindow"><p><b>Бот:</b> Привет! / Сәлем! / Hello!</p></div>
      <input type="text" id="userInput" placeholder="Введите сообщение..." />
      <button class="btn" onclick="sendMessage()">Отправить</button>
    </div>

    <!-- Мобильное приложение -->
    <div class="card">
      <h3>Мобильное приложение "Безопасная школа"</h3>
      <p>Кнопка SOS и сообщение родителю.</p>
      <button class="btn" onclick="sendSOS()">SOS</button>
    </div>

    <!-- Dashboard -->
    <div class="card">
      <h3>Dashboard для учителя</h3>
      <p>Выявление и контроль опасных классов.</p>
      <table>
        <tr>
          <th>Класс</th>
          <th>Жалобы</th>
          <th>Статус</th>
        </tr>
        <tr>
          <td>7А</td>
          <td>5</td>
          <td style="color:red;">Опасный</td>
        </tr>
        <tr>
          <td>8Б</td>
          <td>1</td>
          <td style="color:green;">Норма</td>
        </tr>
        <tr>
          <td>9В</td>
          <td>3</td>
          <td style="color:orange;">Под наблюдением</td>
        </tr>
      </table>
      <button class="btn">Подробнее</button>
    </div>

    <!-- Контактная форма -->
    <div class="card">
      <h3>Байланыс формасы</h3>
      <input type="text" id="name" placeholder="Атыңызды енгізіңіз" />
      <textarea id="message" placeholder="Хабарламаңызды енгізіңіз"></textarea>
      <button class="btn" onclick="sendContact()">Жіберу</button>
    </div>
  </div>

  <!-- EmailJS -->
  <script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"></script>
  <script>
    (function(){
      emailjs.init("U8PoQZ5QjbWFZggd0"); // твой Public Key
    })();

    // Многоязычная логика чат-бота
    function sendMessage() {
      const input = document.getElementById('userInput');
      const chatWindow = document.getElementById('chatWindow');
      const userText = input.value.trim();
      if (!userText) return;

      chatWindow.innerHTML += `<p><b>Вы:</b> ${userText}</p>`;
      let reply;
      const text = userText.toLowerCase();

      // Русский
      if (text.includes("как дела")) reply = "У меня всё отлично! А как у тебя?";
      else if (text.includes("стресс")) reply = "Когда стресс, помогает прогулка, дыхательные упражнения и музыка.";
      else if (text.includes("буллинг")) reply = "Буллинг — серьёзная проблема. Расскажи взрослым, держись рядом с друзьями, сохраняй доказательства и обратись к психологу.";

      // Қазақша
      else if (text.includes("қалайсың")) reply = "Менде бәрі жақсы! Ал сенде қалай?";
      else if (text.includes("қысым") || text.includes("буллинг")) reply = "Буллинг — үлкен мәселе. Сенімді адамдарға айт, жалғыз қалма, дәлелдерді сақта.";

      // English
      else if (text.includes("how are you")) reply = "I'm doing great! How about you?";
      else if (text.includes("stress")) reply = "When stressed, walking, breathing exercises, and music can help.";
      else if (text.includes("bullying")) reply = "Bullying is a serious issue. Tell adults, stay with friends, keep evidence, and seek support.";

      // Default
      else reply = "I try to understand Russian, Kazakh, and English. Please explain your problem more clearly.";

      chatWindow.innerHTML += `<p><b>Бот:</b> ${reply}</p>`;
      chatWindow.scrollTop = chatWindow.scrollHeight;
      input.value = "";
    }

    // Контактная форма с EmailJS
    function sendContact() {
      const name = document.getElementById('name').value.trim();
      const message = document.getElementById('message').value.trim();
      if (!name || !message) {
        alert("Толтырыңыз: аты және хабарлама!");
        return;
      }
      emailjs.send("service_a61kyet", "template_icciynh", {
        from_name: name,
        message: message
      })
      .then(() => {
        alert("Хабарлама жіберілді!");
        document.getElementById('name').value = "";
        document.getElementById('message').value = "";
      }, (error) => {
        alert("Қате пайда болды: " + JSON.stringify(error));
      });
    }

    // Анонимная форма с EmailJS
    function sendAnon() {
      const message = document.getElementById('anonMessage').value.trim();
      if (!message) {
        alert("Введите сообщение!");
        return;
      }
      emailjs.send("service_a61kyet", "template_icciynh", {
        from_name: "Аноним",
        message: message
      })
      .then(() => {
        alert("Анонимное сообщение отправлено!");
        document.getElementById('anonMessage').value = "";
      }, (error) => {
        alert("Ошибка: " + JSON.stringify(error));
      });
    }

    // SOS кнопка с EmailJS
    function sendSOS() {
      emailjs.send("service_a61kyet", "template_icciynh", {
        from_name: "SOS",
        message: "Ученик нажал кнопку SOS! Срочно свяжитесь."
      })
      .then(() => {
        alert("SOS отправлен родителям!");
      }, (error) => {
        alert("Ошибка при отправке SOS: " + JSON.stringify(error));
      });
    }
  </script>
</body>
</html>
